# Configuración del servidor
NODE_ENV=production
PORT=3001

# Zona horaria del servidor (IMPORTANTE para producción)
# Usa el formato de zona horaria de IANA (ej: America/Managua, America/Mexico_City, America/New_York)
# En Render, esta variable controla la zona horaria del contenedor
TZ=America/Managua

# Base de datos PostgreSQL (Neon/Supabase)
# IMPORTANTE: Reemplaza esto con tu DATABASE_URL real de Neon o Supabase
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# JWT Secret (genera uno seguro con: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here

# Frontend URL (Vercel)
FRONTEND_URL=https://your-app-name.vercel.app

# Configuración de CORS
CORS_ORIGIN=https://your-app-name.vercel.app
